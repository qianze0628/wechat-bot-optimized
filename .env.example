# ===== AI 后端（示例: 本机 9router / OpenAI 兼容代理）=====
OPENAI_API_KEY='sk-你的key'
OPENAI_PROXY_URL='http://127.0.0.1:20128/v1/'
OPENAI_MODEL='你的模型名'
OPENAI_SYSTEM_MESSAGE='你是一个友善的个人微信AI助手'

# ===== 白名单 =====
# 你的微信昵称（群聊中被@时触发回复）
BOT_NAME='@你的昵称'
# 允许自动回复的联系人（多个用英文逗号分隔）
ALIAS_WHITELIST=''
# 允许自动回复的群聊（多个用英文逗号分隔）
ROOM_WHITELIST=''
# 免@群（群内所有消息自动触发机器人，无需@）
NO_MENTION_ROOMS=''
# 群聊总开关（false=关闭群聊）
ROOM_CHAT_ENABLED=true
# 敏感词（AI 回复中禁止出现，自动替换为*）
SENSITIVE_WORDS=''

# ===== 服务类型 =====
# ChatGPT / doubao / deepseek / Kimi / Xunfei / deepseek-free / 302AI / dify / ollama / tongyi / claude / pi
SERVICE_TYPE='ChatGPT'

# ===== 本地消息记录 =====
WECHAT_DATA_DIR='.data/wechat'
WECHAT_STORE_MESSAGES='true'
BOT_COMMAND_PREFIX='/'
ENABLE_REMOTE_OPENCLI='false'